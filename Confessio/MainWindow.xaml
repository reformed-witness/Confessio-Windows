<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Confessio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Confessio"
    Title="Confessio">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Title="Confessio"
                  IsBackButtonVisible="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
                  IsPaneToggleButtonVisible="True"
                  BackRequested="AppTitleBar_BackRequested"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Square44x44Logo.scale-200.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="SearchBox"
                                Width="360"
                                VerticalAlignment="Center"
                                PlaceholderText="Search confessions"
                                QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                DisplayMemberPath="DisplayText">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F"
                                             Modifiers="Control"
                                             Invoked="SearchKeyboardAccelerator_Invoked" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        CompactModeThresholdWidth="720"
                        ExpandedModeThresholdWidth="1180"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        PaneDisplayMode="Auto"
                        ItemInvoked="NavView_ItemInvoked"
                        Loaded="NavView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="All confessions" Tag="All" Icon="Home" />
                <NavigationViewItemHeader Content="Collections" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"
                   Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
